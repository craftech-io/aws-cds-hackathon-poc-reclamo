{
  "name": "aws-cds-hackathon-poc-reclamo",
  "version": "0.1.0",
  "private": true,
  "description": "Reclamo en regla: a regulated-complaints agent for consumer lenders and wallets in Latin America, by Craftech",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "22.14.0",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/shared",
    "packages/bff",
    "packages/web",
    "packages/core-contract",
    "packages/core-mock",
    "packages/network-mock"
  ],
  "scripts": {
    "postinstall": "sst install --stage poc",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck:infra && npm run typecheck --workspaces --if-present",
    "typecheck:infra": "tsx scripts/lint/typecheck-infra.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test -c packages/web/e2e/playwright.config.ts",
    "test:poc": "playwright test -c packages/web/e2e/poc/playwright.config.ts",
    "test:poc:guest": "POC_QA_SIGNUP=1 sst shell --stage poc -- playwright test -c packages/web/e2e/poc/playwright.config.ts guest.spec.ts --project desktop",
    "lint": "tsx scripts/lint/max-lines.ts && tsx scripts/lint/no-intl.ts",
    "lint:duplicates": "tsx scripts/lint/duplicates.ts",
    "lint:forbidden": "tsx scripts/lint/forbidden-terms.ts",
    "lint:neutral-surfaces": "tsx scripts/lint/neutral-surfaces.ts",
    "lint:wp-ownership": "tsx scripts/lint/wp-ownership.ts",
    "lint:chokepoint": "tsx scripts/lint/chokepoint.ts",
    "lint:no-ses-receiving": "tsx scripts/lint/no-ses-receiving.ts",
    "flows:check": "tsx scripts/flows/check.ts",
    "tour:check": "tsx scripts/tour/check.ts",
    "landing:capture": "tsx scripts/landing/capture-console.ts",
    "landing:lcp": "tsx scripts/landing/lcp.ts",
    "diagram:render": "tsx scripts/diagram/render-architecture.ts",
    "core:contract": "tsx scripts/core/contract-check.ts",
    "register:verify": "tsx scripts/register/verify.ts",
    "tools:build-schemas": "tsx packages/bff/src/agent-tools/common/build-schemas.ts",
    "channels:check-modes": "tsx scripts/channels/check-modes.ts",
    "channels:whatsapp-templates": "sst shell --stage poc -- tsx scripts/channels/whatsapp-templates.ts",
    "channels:waba-event-destination": "sst shell --stage poc -- tsx scripts/channels/waba-event-destination.ts",
    "console:invite": "sst shell --stage poc -- tsx scripts/console/invite.ts",
    "console:check-guests": "sst shell --stage poc -- tsx scripts/console/check-guests.ts",
    "console:unverify-staff": "sst shell --stage poc -- tsx scripts/console/unverify-staff.ts",
    "leads:export": "sst shell --stage poc -- tsx scripts/leads/export.ts",
    "leads:delete": "sst shell --stage poc -- tsx scripts/leads/delete.ts",
    "leads:notice-test": "sst shell --stage poc -- tsx scripts/leads/notice-test.ts",
    "guests:signup-switch": "sst shell --stage poc -- tsx scripts/guests/signup-switch.ts",
    "seed:generate": "tsx scripts/seed/generate.ts",
    "seed:validate": "tsx scripts/seed/validate.ts",
    "seed:load": "sst shell --stage poc -- tsx scripts/seed/load.ts",
    "scenarios": "tsx scripts/scenarios/run.ts",
    "evals": "tsx scripts/evals/run.ts",
    "smoke:interim": "tsx scripts/smoke/interim.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.1135.0",
    "@aws-sdk/client-bedrock-agentcore-control": "3.1135.0",
    "@aws-sdk/client-bedrock-runtime": "3.1135.0",
    "@aws-sdk/client-cloudwatch": "3.1135.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1135.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1135.0",
    "@aws-sdk/client-dynamodb": "3.1135.0",
    "@aws-sdk/client-iam": "3.1135.0",
    "@aws-sdk/client-lambda": "3.1135.0",
    "@aws-sdk/client-s3": "3.1135.0",
    "@aws-sdk/client-scheduler": "3.1135.0",
    "@aws-sdk/client-sesv2": "3.1135.0",
    "@aws-sdk/client-socialmessaging": "3.1135.0",
    "@aws-sdk/client-sqs": "3.1135.0",
    "@aws-sdk/lib-dynamodb": "3.1135.0",
    "@playwright/test": "1.63.0",
    "@smithy/node-http-handler": "4.12.1",
    "@types/node": "22.20.3",
    "fflate": "0.8.3",
    "sst": "4.17.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "unpdf": "1.8.1",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
