node_modules/
.sst/
dist/
.env*

# Keys and certificates (WhatsApp/Meta, signing material)
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
*.tsbuildinfo
.DS_Store

# sst-env.d.ts files are generated by SST (sst deploy) and are committed on purpose: "sst install"
# does not produce them, and typecheck in CI runs without AWS credentials.

# Local-only files: never committed (real phone numbers, verified emails, test devices)
scripts/seed/overrides.local.json
*.local.json
*.local.*

# QA evidence that may carry real addresses or headers
tests/evidence/**/*.har
tests/evidence/**/*.zip

# Playwright output
test-results/
playwright-report/

# Build and tooling output
build/
coverage/
*.log
npm-debug.log*

# Editors
.vscode/
.idea/
*.swp
